{
  "name": "smart-model-router",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-independent AI model routing platform: picks model and reasoning effort per coding task.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "build:mod": "node packages/claude-code-mod/scripts/build.js",
    "build:plugin": "node packages/claude-code-mod/scripts/build.js --out plugins/smart-model-router",
    "build:dashboard": "npm run build -w @smr/dashboard",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "16.3.3",
    "@vitest/coverage-v8": "^5.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "31.0.0",
    "vitest": "^5.1.1"
  }
}
